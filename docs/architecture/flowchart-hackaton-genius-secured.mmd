%%{init: {
    "theme": "base",
    "themeVariables": {
        "fontFamily": "Trebuchet MS, Segoe UI, sans-serif",
        "primaryColor": "#dff4ff",
        "primaryTextColor": "#0f172a",
        "primaryBorderColor": "#0284c7",
        "lineColor": "#0f172a",
        "secondaryColor": "#fef3c7",
        "tertiaryColor": "#ecfeff",
        "background": "#f8fafc"
    },
    "flowchart": {
        "curve": "basis",
        "nodeSpacing": 36,
        "rankSpacing": 52,
        "padding": 16
    }
}}%%

flowchart TD
        U([Student / użytkownik]) --> W([ADK Web Client])
        W --> DOCKER["🐳 Docker Sandbox<br/>(read-only, unprivileged, no-new-privileges)"]
        
        DOCKER --> O[HackathonGenius<br/>SequentialAgent / orkiestrator]

        O --> SEC["🔐 Security Gate<br/>(IdeaAgent boundary)"]
        
        subgraph SECURITY["Security Callbacks"]
            direction TB
            RATE["⚡ Rate Limiter<br/>(10 req/min, burst=3)"]
            INJ["🛡️ Prompt Injection Guard<br/>(22 patterns, 500 char max)"]
            TOOL["🔒 Tool Argument Guard<br/>(allowlist, path traversal block)"]
        end
        
        SEC --> RATE --> INJ --> TOOL
        
        TOOL --> A1["IdeaAgent<br/>(human boundary)"]

        subgraph ORCH[Pipeline agentów]
            direction LR
            A2["TechStackAgent<br/>(no callbacks)"]
            A3["TimelineAgent<br/>(no callbacks)"]
            A4["PitchAgent<br/>(no callbacks)"]
        end

        A1 --> A2 --> A3 --> A4

        subgraph TOOLS[Narzędzia]
            direction LR
            T1[browse_hackathon_themes]
            T2[get_tech_stack_library]
            T3[get_sprint_templates]
            T4[get_pitch_frameworks]
        end

        A1 --> T1
        A2 --> T2
        A3 --> T3
        A4 --> T4

        S[(session.state<br/>internal trusted zone)]
        A1 -. validated session .-> S
        A2 -. internal state .-> S
        A3 -. internal state .-> S
        A4 -. internal state .-> S

        M[config/model_config.py]
        A1 --> M
        A2 --> M
        A3 --> M
        A4 --> M

        P["🔗 External LLM Service<br/>(OpenAI / Gemini / Custom API)"]
        V[LLM Provider API]
        L([Language Model])
        M --> P --> V --> L

        classDef agent fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0f172a;
        classDef tool fill:#ecfccb,stroke:#65a30d,stroke-width:1.5px,color:#1a2e05;
        classDef infra fill:#fef3c7,stroke:#d97706,stroke-width:1.5px,color:#3f2a00;
        classDef state fill:#fee2e2,stroke:#dc2626,stroke-width:1.5px,color:#3f0a0a;
        classDef user fill:#ede9fe,stroke:#7c3aed,stroke-width:1.5px,color:#2e1065;
        classDef security fill:#dbeafe,stroke:#e11d48,stroke-width:2.5px,color:#500724;
        classDef docker fill:#e0e7ff,stroke:#312e81,stroke-width:2.5px,color:#1e1b4b;

        class O,A1,A2,A3,A4 agent;
        class T1,T2,T3,T4 tool;
        class M,P,V,L infra;
        class S state;
        class U,W user;
        class SEC,RATE,INJ,TOOL,SECURITY security;
        class DOCKER docker;
