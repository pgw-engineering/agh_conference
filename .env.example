# Skopiuj ten plik jako .env i uzupełnij wartości:
#   cp .env.example .env

# --- Rekomendowane: płatne Gemini API (Google AI Studio) ---
# Wklej własny klucz z https://aistudio.google.com/apikey
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Tańsza alternatywa:
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- Legacy: LM Proxy (Docker -> host) ---
# LM_PROXY_BASE_URL=http://host.docker.internal:4000/openai/v1
# LM_PROXY_API_KEY=sk-placeholder
# LM_PROXY_MODEL=gpt-4o-mini

# --- Alternatywnie: inne OpenAI-compatible API ---
# OPENAI_API_BASE=https://your-provider.example.com/v1
# OPENAI_API_KEY=your-key
